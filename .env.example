APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/paperlight.db
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_DIR=./data/objects
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=paperlight
S3_REGION=us-east-1
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SESSION_TTL_HOURS=12
DOCUMENT_RETENTION_DAYS=7
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
# Current owner-only production stage intentionally uses password-only login.
REQUIRE_TOTP=0
COOKIE_SECURE=0
TRUST_PROXY=0
JOB_MODE=eager
REDIS_URL=redis://127.0.0.1:6379/0
DETECTOR_MODE=mock
REWRITE_MODE=mock
# Real Pangram detection remains disabled until its data terms are reviewed and this
# acknowledgement is deliberately changed to 1 on the backend.
DETECTOR_DATA_PROCESSING_ACKNOWLEDGED=0
PANGRAM_PAID_CALLS_ENABLED=0
PANGRAM_API_BASE_URL=https://text.external-api.pangram.com
PANGRAM_API_KEY=
PANGRAM_MODEL=pangram-4
PANGRAM_POLL_INTERVAL_SECONDS=0.75
PANGRAM_MAX_POLL_SECONDS=45
PANGRAM_HOURLY_WARNING=1
PANGRAM_HOURLY_HARD_LIMIT=2
PANGRAM_DAILY_HARD_LIMIT=4
PANGRAM_MAX_CONCURRENT_CALLS=1
PANGRAM_RESERVATION_TTL_SECONDS=900
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_VALIDATOR_MODEL=deepseek-v4-flash
PROVIDER_TIMEOUT_SECONDS=45
PAID_CALL_HOURLY_WARNING=10
PAID_CALL_HOURLY_HARD_LIMIT=20
PROVIDER_FAILURE_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_SECONDS=900
PROVIDER_USAGE_RETENTION_DAYS=30
# Product billing is disabled for the current owner-only deployment. Use test
# only outside production; use stripe only after the Price and webhook exist.
BILLING_MODE=disabled
BILLING_DISABLED_PLAN=pro
BILLING_APP_URL=http://127.0.0.1:3000
BILLING_PAST_DUE_GRACE_DAYS=3
BILLING_FREE_DOCUMENTS=3
BILLING_FREE_STORAGE_BYTES=10485760
BILLING_FREE_DETECTION_RUNS=2
BILLING_FREE_REWRITE_RUNS=5
BILLING_PRO_DOCUMENTS=25
BILLING_PRO_STORAGE_BYTES=262144000
BILLING_PRO_DETECTION_RUNS=20
BILLING_PRO_REWRITE_RUNS=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BASE_PATH=
